<?xml version="1.0"?>
<sdf version="1.6">
  <world name="road_with_traffic">
    <physics name="default_physics" default="true" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/gazebo</namespace></ros>
      <update_rate>1.0</update_rate>
    </plugin>

    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <model name="grass">
      <static>true</static>
      <pose>30 0 0.001 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>160 160 0.001</size></box></geometry>
          <material><ambient>0.12 0.28 0.12 1</ambient><diffuse>0.12 0.28 0.12 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="road_main">
      <static>true</static>
      <pose>30 0.25 0.002 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>72 1.4 0.001</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="road_crossing">
      <static>true</static>
      <pose>25 0 0.0021 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1.2 12 0.001</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="lane_right">
      <static>true</static>
      <pose>30 -0.25 0.003 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>72 0.05 0.001</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="lane_left">
      <static>true</static>
      <pose>30 0.25 0.003 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>72 0.05 0.001</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="lead_car">
      <pose>5.0 0.0 0 0 0 0</pose>
      <link name="body">
        <kinematic>true</kinematic>
        <gravity>false</gravity>
        <inertial><mass>5.0</mass>
          <inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <pose>0 0 0.225 0 0 0</pose>
          <geometry><box><size>0.5 0.25 0.35</size></box></geometry>
        </collision>
        <visual name="body">
          <pose>0 0 0.18 0 0 0</pose>
          <geometry><box><size>0.5 0.25 0.26</size></box></geometry>
          <material><ambient>0.1 0.3 0.8 1</ambient><diffuse>0.1 0.3 0.8 1</diffuse></material>
        </visual>
        <visual name="cabin">
          <pose>-0.03 0 0.36 0 0 0</pose>
          <geometry><box><size>0.28 0.22 0.1</size></box></geometry>
          <material><ambient>0.15 0.15 0.2 1</ambient><diffuse>0.15 0.15 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="oncoming_car_1">
      <pose>30.0 0.6 0 0 0 3.1416</pose>
      <link name="body">
        <kinematic>true</kinematic>
        <gravity>false</gravity>
        <inertial><mass>5.0</mass>
          <inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <pose>0 0 0.225 0 0 0</pose>
          <geometry><box><size>0.5 0.25 0.35</size></box></geometry>
        </collision>
        <visual name="body">
          <pose>0 0 0.18 0 0 0</pose>
          <geometry><box><size>0.5 0.25 0.26</size></box></geometry>
          <material><ambient>0.9 0.5 0.1 1</ambient><diffuse>0.9 0.5 0.1 1</diffuse></material>
        </visual>
        <visual name="cabin">
          <pose>-0.03 0 0.36 0 0 0</pose>
          <geometry><box><size>0.28 0.22 0.1</size></box></geometry>
          <material><ambient>0.15 0.15 0.2 1</ambient><diffuse>0.15 0.15 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="oncoming_car_2">
      <pose>50.0 0.6 0 0 0 3.1416</pose>
      <link name="body">
        <kinematic>true</kinematic>
        <gravity>false</gravity>
        <inertial><mass>5.0</mass>
          <inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <pose>0 0 0.225 0 0 0</pose>
          <geometry><box><size>0.5 0.25 0.35</size></box></geometry>
        </collision>
        <visual name="body">
          <pose>0 0 0.18 0 0 0</pose>
          <geometry><box><size>0.5 0.25 0.26</size></box></geometry>
          <material><ambient>0.1 0.6 0.2 1</ambient><diffuse>0.1 0.6 0.2 1</diffuse></material>
        </visual>
        <visual name="cabin">
          <pose>-0.03 0 0.36 0 0 0</pose>
          <geometry><box><size>0.28 0.22 0.1</size></box></geometry>
          <material><ambient>0.15 0.15 0.2 1</ambient><diffuse>0.15 0.15 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="crossing_car">
      <pose>25.0 -3.0 0 0 0 1.5708</pose>
      <link name="body">
        <kinematic>true</kinematic>
        <gravity>false</gravity>
        <inertial><mass>5.0</mass>
          <inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <pose>0 0 0.225 0 0 0</pose>
          <geometry><box><size>0.5 0.25 0.35</size></box></geometry>
        </collision>
        <visual name="body">
          <pose>0 0 0.18 0 0 0</pose>
          <geometry><box><size>0.5 0.25 0.26</size></box></geometry>
          <material><ambient>0.6 0.2 0.7 1</ambient><diffuse>0.6 0.2 0.7 1</diffuse></material>
        </visual>
        <visual name="cabin">
          <pose>-0.03 0 0.36 0 0 0</pose>
          <geometry><box><size>0.28 0.22 0.1</size></box></geometry>
          <material><ambient>0.15 0.15 0.2 1</ambient><diffuse>0.15 0.15 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
